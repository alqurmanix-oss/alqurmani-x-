<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="theme-color" content="#101827">
  <title>تبرعك يصنع فرقًا | AQX</title>
  <style>
    :root{color-scheme:dark;--bg:#0b1220;--panel:#121d2e;--line:#26364c;--text:#f4f7fb;--muted:#a9b7c9;--accent:#38bdf8;--accent2:#0ea5e9;--danger:#fca5a5}
    *{box-sizing:border-box}
    body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% 0,#18304a 0,var(--bg) 58%);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,Arial,sans-serif;display:grid;place-items:center;padding:24px}
    .wrap{width:min(100%,520px)}
    .brand{text-align:center;margin-bottom:18px}
    .logo{width:58px;height:58px;margin:auto auto 12px;border:1px solid #36516d;border-radius:18px;display:grid;place-items:center;background:#14263a;font-weight:900;font-size:22px;color:var(--accent)}
    h1{font-size:clamp(25px,5vw,34px);margin:0 0 8px}
    .intro{color:var(--muted);line-height:1.8;margin:0}
    .card{background:linear-gradient(160deg,rgba(23,39,59,.98),rgba(15,25,40,.98));border:1px solid var(--line);border-radius:22px;padding:clamp(20px,5vw,30px);box-shadow:0 24px 80px #0006}
    label{display:block;font-weight:700;margin:0 0 10px}
    .amounts{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:17px}
    .preset{border:1px solid var(--line);background:#101b2b;color:var(--text);border-radius:12px;padding:12px 6px;font:inherit;font-weight:700;cursor:pointer}
    .preset[aria-pressed=true]{border-color:var(--accent);background:#12314a;color:#bdeaff}
    .fields{display:grid;grid-template-columns:1fr 125px;gap:10px}
    input,select{width:100%;min-height:50px;border:1px solid var(--line);border-radius:12px;background:#0b1523;color:var(--text);padding:0 13px;font:inherit;outline:none}
    input:focus,select:focus,.preset:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
    .hint{color:var(--muted);font-size:13px;line-height:1.7;margin:9px 0 20px}
    .pay{width:100%;min-height:54px;border:0;border-radius:13px;background:linear-gradient(90deg,var(--accent2),#0284c7);color:#031321;font:inherit;font-weight:900;font-size:17px;cursor:pointer}
    .pay:disabled{opacity:.6;cursor:wait}
    .status{display:none;margin-top:15px;padding:12px 14px;border-radius:12px;line-height:1.7;font-size:14px}
    .status.show{display:block;background:#182b40;border:1px solid #35516d}
    .status.error{background:#3a1d27;border-color:#75404d;color:#ffe1e1}
    .secure{display:flex;align-items:center;justify-content:center;gap:8px;color:var(--muted);font-size:13px;margin:17px 0 0}
    .foot{text-align:center;color:#8192a8;font-size:12px;margin:17px 0 0;line-height:1.7}
    @media(max-width:390px){.fields{grid-template-columns:1fr 105px}.amounts{gap:6px}.preset{font-size:14px}}
  </style>
</head>
<body>
  <main class="wrap">
    <header class="brand">
      <div class="logo" aria-hidden="true">AQX</div>
      <h1>ساهم في صنع فرق ❤️</h1>
      <p class="intro">اختر مبلغ التبرع والعملة، ثم أكمل الدفع بأمان عبر PayPal.<br>لا تحتاج إلى إنشاء حساب أو تسجيل الدخول هنا.</p>
    </header>

    <section class="card" aria-labelledby="donation-title">
      <h2 id="donation-title" style="font-size:18px;margin:0 0 18px">تفاصيل التبرع</h2>
      <form id="donation-form">
        <label for="amount">مبلغ التبرع</label>
        <div class="amounts" aria-label="مبالغ مقترحة">
          <button class="preset" type="button" data-amount="10" aria-pressed="true">10</button>
          <button class="preset" type="button" data-amount="25" aria-pressed="false">25</button>
          <button class="preset" type="button" data-amount="50" aria-pressed="false">50</button>
        </div>
        <div class="fields">
          <input id="amount" name="amount" type="number" inputmode="decimal" min="1" max="100000" step="0.01" value="10" required aria-describedby="amount-hint">
          <select id="currency" name="currency" aria-label="العملة">
            <option value="USD">USD — دولار</option>
            <option value="EUR">EUR — يورو</option>
            <option value="GBP">GBP — جنيه إسترليني</option>
          </select>
        </div>
        <p class="hint" id="amount-hint">الحد الأدنى 1 والحد الأقصى 100,000. العملات المتاحة حاليًا: USD وEUR وGBP.</p>
        <button class="pay" id="pay-button" type="submit">المتابعة إلى PayPal</button>
        <div class="status" id="status" role="status" aria-live="polite"></div>
      </form>
      <div class="secure"><span aria-hidden="true">🔒</span><span>بيانات الدفع تُعالج عبر PayPal — لا ندخل بيانات بطاقتك في هذه الصفحة.</span></div>
    </section>
    <p class="foot">لن يتم اعتبار التبرع مكتملًا إلا بعد تأكيد PayPal للعملية.<br>© AQX</p>
  </main>

  <script>
    "use strict";

    // نقطة الاتصال المنشورة لوظيفة التبرعات في مشروع AQX-Identity فقط.
    const DONATION_API =
      "https://fkiokwwztbyztleeuwks.supabase.co/functions/v1/aqx-public-donations";

    const form = document.getElementById("donation-form");
    const amountInput = document.getElementById("amount");
    const currencyInput = document.getElementById("currency");
    const payButton = document.getElementById("pay-button");
    const statusBox = document.getElementById("status");
    const presets = [...document.querySelectorAll(".preset")];

    function showStatus(message, isError = false) {
      statusBox.textContent = message;
      statusBox.className = "status show" + (isError ? " error" : "");
    }

    presets.forEach((button) => {
      button.addEventListener("click", () => {
        amountInput.value = button.dataset.amount;
        presets.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button))
        );
      });
    });

    amountInput.addEventListener("input", () => {
      presets.forEach((item) =>
        item.setAttribute("aria-pressed", String(item.dataset.amount === amountInput.value))
      );
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (payButton.disabled) return;

      const amount = Number(amountInput.value);
      const currency = currencyInput.value;

      if (!Number.isFinite(amount) || amount < 1 || amount > 100000) {
        showStatus("أدخل مبلغًا صحيحًا بين 1 و100,000.", true);
        amountInput.focus();
        return;
      }
      if (!["USD", "EUR", "GBP"].includes(currency)) {
        showStatus("العملة المختارة غير مدعومة.", true);
        return;
      }

      payButton.disabled = true;
      payButton.textContent = "جارٍ إنشاء طلب الدفع...";
      statusBox.className = "status";
      statusBox.textContent = "";

      try {
        const response = await fetch(DONATION_API + "?action=create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ amount, currency }),
          cache: "no-store",
          credentials: "omit",
          referrerPolicy: "strict-origin-when-cross-origin"
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || "تعذر إنشاء طلب التبرع. حاول مرة أخرى.");
        }

        if (
          typeof data.order_id !== "string" ||
          typeof data.approval_url !== "string"
        ) {
          throw new Error("استجابة خادم الدفع غير مكتملة.");
        }

        const approval = new URL(data.approval_url);
        if (
          approval.protocol !== "https:" ||
          !["www.paypal.com", "www.sandbox.paypal.com", "paypal.com", "sandbox.paypal.com"].includes(approval.hostname)
        ) {
          throw new Error("رابط موافقة الدفع غير موثوق؛ تم إيقاف التحويل للحماية.");
        }

        showStatus("تم إنشاء طلب الدفع. جارٍ تحويلك إلى PayPal...");
        window.location.assign(approval.href);
      } catch (error) {
        showStatus(
          error instanceof Error ? error.message : "حدث خطأ غير متوقع.",
          true
        );
        payButton.disabled = false;
        payButton.textContent = "إعادة المحاولة";
      }
    });
  </script>
</body>
</html>
